# ── Shared ──────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info
# "console" (default): colored, human-readable — watch the agent work in a
# terminal. "json": one-line-per-event structured logs, for a log aggregator.
LOG_FORMAT=console

# ── PayPal (Sandbox) ────────────────────────────────────────────────────
# From developer.paypal.com → Apps & Credentials → Sandbox → your app
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=SANDBOX
# Only needed once a webhook is registered in the PayPal dashboard pointing
# at a public URL (e.g. after deploying) — leave blank for local dev.
PAYPAL_WEBHOOK_ID=

# ── LLM provider ────────────────────────────────────────────────────────
# "gemini" for deployed/demo, "ollama" for local dev loop
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# Any Gemini model your key can use; if one is overloaded (503) try another, e.g. gemini-3.1-flash-lite
GEMINI_MODEL=gemini-3.8-flash
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# ── agent service (FastAPI) ─────────────────────────────────────────────
AGENT_PORT=8000
AGENT_INTERNAL_TOKEN=change-me-to-a-long-random-string
# localhost here — for running `uv run uvicorn ...` directly on the host.
# docker-compose.yml overrides these to the `postgres`/`redis` service
# hostnames for the containerized agent/worker, so you don't need to change
# this when switching between docker and local dev.
DATABASE_URL=postgresql+asyncpg://settl:settl@localhost:5432/settl_agent
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_PER_MINUTE=60

# ── web app (Next.js) ───────────────────────────────────────────────────
# localhost here too — same reasoning as DATABASE_URL/REDIS_URL above.
WEB_PORT=3000
AGENT_SERVICE_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=SettlAgent

# ── console login (apps/web auth gate) ──
# Operator account for the dashboard. Set a strong ADMIN_PASSWORD; generate SESSION_SECRET with:
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
SESSION_SECRET=

# ── Payment Guardian ──
# Settlements at/above this gross USD amount are held for human approval.
GUARDIAN_REVIEW_THRESHOLD=500
